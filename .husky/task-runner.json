{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
    {
      "name": "dotnet-format",
      "command": "dotnet",
      "args": ["format", "--verify-no-changes", "--verbosity", "diagnostic"],
      "include": ["**/*.cs", "**/*.csproj", "**/*.sln", "**/*.slnx"]
    }
   ]
}
